<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iPad／iPhone 線上安裝（itms-services）。.ipa 放在 GitHub Release 最新版，檔名固定 xiaoke-shift-ios.ipa，所以永遠裝最新版；發新版要改這裡的 bundle-version -->
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>assets</key>
			<array>
				<dict>
					<key>kind</key>
					<string>software-package</string>
					<key>url</key>
					<string>https://github.com/achir1015/xiaoke-shift/releases/latest/download/xiaoke-shift-ios.ipa</string>
				</dict>
				<dict>
					<key>kind</key>
					<string>display-image</string>
					<key>url</key>
					<string>https://achir1015.github.io/xiaoke-shift/ios/icon-57.png</string>
				</dict>
				<dict>
					<key>kind</key>
					<string>full-size-image</string>
					<key>url</key>
					<string>https://achir1015.github.io/xiaoke-shift/ios/icon-512.png</string>
				</dict>
			</array>
			<key>metadata</key>
			<dict>
				<key>bundle-identifier</key>
				<string>com.achir.xiaokeshift</string>
				<key>bundle-version</key>
				<string>1.2.1</string>
				<key>kind</key>
				<string>software</string>
				<key>title</key>
				<string>小柯班表助手</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
